From: Anland Hyprland Maintainers
Date: Wed, 12 Aug 2026 10:30:00 +0800
Subject: compat: implement pending idle frame for Anland output

Aquamarine 0.14 adds pendingIdleFrame() as a pure virtual output method.
Anland does not maintain a separate idle-frame queue, so report no pending
idle frame.
---
 include/aquamarine/backend/AnlandOutput.hpp | 1 +
 src/backend/anland/AnlandOutput.cpp          | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/include/aquamarine/backend/AnlandOutput.hpp b/include/aquamarine/backend/AnlandOutput.hpp
--- a/include/aquamarine/backend/AnlandOutput.hpp
+++ b/include/aquamarine/backend/AnlandOutput.hpp
@@ -25,6 +25,7 @@ namespace Aquamarine {
         virtual Hyprutils::Memory::CSharedPointer<IBackendImplementation>                 getBackend() override;
         virtual std::vector<SDRMFormat>                                                   getRenderFormats() override;
+        virtual bool                                                                      pendingIdleFrame() override;
         virtual bool                                                                      pendingPageFlip() override;
         virtual void                                                                      scheduleFrame(const scheduleFrameReason reason = AQ_SCHEDULE_UNKNOWN) override;
         virtual bool                                                                      destroy() override;

diff --git a/src/backend/anland/AnlandOutput.cpp b/src/backend/anland/AnlandOutput.cpp
--- a/src/backend/anland/AnlandOutput.cpp
+++ b/src/backend/anland/AnlandOutput.cpp
@@ -270,6 +270,10 @@ std::vector<SDRMFormat> CAnlandOutput::getRenderFormats() {
     };
 }
 
+bool CAnlandOutput::pendingIdleFrame() {
+    return false;
+}
+
 bool CAnlandOutput::pendingPageFlip() {
     return m_awaitingConsumer;
 }