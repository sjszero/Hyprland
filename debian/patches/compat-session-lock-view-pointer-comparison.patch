From: Anland Hyprland Maintainers
Date: Fri, 8 Aug 2026 09:20:00 +0800
Subject: compat: compare session lock through IView pointer

Forky's hyprutils does not compare shared and weak pointers across related
but different template types.  Lock the self reference and compare it as the
IView base pointer held by m_otherViews.

---
 src/desktop/view/SessionLock.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/desktop/view/SessionLock.cpp b/src/desktop/view/SessionLock.cpp
--- a/src/desktop/view/SessionLock.cpp
+++ b/src/desktop/view/SessionLock.cpp
@@ -31,1 +31,4 @@ void View::CSessionLock::init() {
-    m_listeners.destroy = m_surface->m_events.destroy.listen([this] { std::erase_if(g_pCompositor->m_otherViews, [this](const auto& e) { return e == m_self; }); });
+    m_listeners.destroy = m_surface->m_events.destroy.listen([this] {
+        const SP<IView> self = m_self.lock();
+        std::erase_if(g_pCompositor->m_otherViews, [&self](const auto& e) { return e == self; });
+    });
