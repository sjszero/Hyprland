         if (!surface.valid()) {
--- a/third_party/hyprgrass/src/main.cpp
+++ b/third_party/hyprgrass/src/main.cpp
@@ -187,6 +187,7 @@
     }
 
     int ref      = luaL_ref(L, LUA_REGISTRYINDEX);
+    Config::Lua::mgr()->registerLuaRef(ref);
     bind.handler = "__lua";
     bind.arg     = std::to_string(ref);
 
