From: Anland packaging maintainers <packaging@anland.invalid>
Date: Tue, 19 Aug 2026 12:00:00 +0800
Subject: [PATCH] hyprgrass: adapt clean v0.8.2 config handles for Hyprland 0.56 Lua API

Keep the v0.8.2 source baseline unchanged; this Debian patch maps plugin
configuration access to Hyprland 0.56 Lua configuration values.

Forwarded: not-needed
---
--- a/third_party/hyprgrass/src/GestureManager.cpp
+++ b/third_party/hyprgrass/src/GestureManager.cpp
@@ -92,12 +92,12 @@
 }
 
 GestureManager::GestureManager() : IGestureManager(std::make_unique<HyprLogger>()) {
-    static auto const PSENSITIVITY     = g_config->sensitivity;
-    static auto const LONG_PRESS_DELAY = g_config->longPressDelay;
-    static auto const EDGE_MARGIN      = g_config->edgeMargin;
-    const auto sensitivity             = PSENSITIVITY->m_val.ptr();
-    const auto longPressDelay          = LONG_PRESS_DELAY->m_val.ptr();
-    const auto margin                  = EDGE_MARGIN->m_val.ptr();
+    static auto const PSENSITIVITY     = CConfigValue<Config::FLOAT>("plugin:hyprgrass:sensitivity");
+    static auto const LONG_PRESS_DELAY = CConfigValue<Config::INTEGER>("plugin:hyprgrass:long_press_delay");
+    static auto const EDGE_MARGIN      = CConfigValue<Config::INTEGER>("plugin:hyprgrass:edge_margin");
+    const auto sensitivity             = PSENSITIVITY.ptr();
+    const auto longPressDelay          = LONG_PRESS_DELAY.ptr();
+    const auto margin                  = EDGE_MARGIN.ptr();
 
     this->addEdgeSwipeGesture(SWIPE_THRESHOLD, SWIPE_INCORRECT_DRAG_TOLERANCE, sensitivity, longPressDelay, margin);
     // TODO: should I use SWIPE_INCORRECT_DRAG_TOLERANCE instead?
@@ -121,9 +121,9 @@
 }
 
