From: Anland Hyprland Maintainers
Date: Fri, 8 Aug 2026 11:00:00 +0800
Subject: [PATCH] compat: use explicit unique-pointer conversions in protocols

Forky's hyprutils makes CUniquePointer's boolean conversion explicit and does
not permit conversion of the smart pointer itself to uintptr_t.  Make the
three boolean returns and the diagnostic pointer conversion explicit.

--- a/src/protocols/ExtWorkspace.cpp
+++ b/src/protocols/ExtWorkspace.cpp
@@ -45,7 +45,7 @@ CExtWorkspaceGroupResource::CExtWorkspaceGroupResource(WP<CExtWorkspaceManagerR
 }
 
 bool CExtWorkspaceGroupResource::good() const {
-    return m_resource;
+    return static_cast<bool>(m_resource);
 }
 
 WP<CExtWorkspaceGroupResource> CExtWorkspaceGroupResource::fromResource(wl_resource* resource) {
@@ -131,7 +131,7 @@ CExtWorkspaceResource::CExtWorkspaceResource(WP<CExtWorkspaceManagerResource> m
 }
 
 bool CExtWorkspaceResource::good() const {
-    return m_resource;
+    return static_cast<bool>(m_resource);
 }
 
 bool CExtWorkspaceResource::isActive() const {
@@ -243,7 +243,7 @@ void CExtWorkspaceManagerResource::init(WP<CExtWorkspaceManagerResource> self) {
 }
 
 bool CExtWorkspaceManagerResource::good() const {
-    return m_resource;
+    return static_cast<bool>(m_resource);
 }
 
 void CExtWorkspaceManagerResource::scheduleDone() {
--- a/src/protocols/Fifo.cpp
+++ b/src/protocols/Fifo.cpp
@@ -141,7 +141,7 @@ CFifoProtocol::CFifoProtocol() : IWaylandProtocol(&wp_fifo_manager_v1_interface
         }
 
         surf->m_fifo = RESOURCE;
-        LOGM(Log::DEBUG, "New fifo at {:x} for surface {:x}", (uintptr_t)RESOURCE, (uintptr_t)surf.get());
+        LOGM(Log::DEBUG, "New fifo at {:x} for surface {:x}", (uintptr_t)RESOURCE.get(), (uintptr_t)surf.get());
     });
 }

 