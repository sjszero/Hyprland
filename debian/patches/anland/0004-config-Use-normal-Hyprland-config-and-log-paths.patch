From: Anland Hyprland Maintainers <anland@example.invalid>
Date: Thu, 7 Aug 2026 13:00:00 +0800
Subject: config: Use normal Hyprland config and log paths in Anland sessions

Split from the Anland Hyprland integration series for reviewable, independently revertible changes.

---
Index: anland-quilt4/src/config/supplementary/jeremy/Jeremy.cpp
===================================================================
--- anland-quilt4.orig/src/config/supplementary/jeremy/Jeremy.cpp
+++ anland-quilt4/src/config/supplementary/jeremy/Jeremy.cpp
@@ -32,12 +32,12 @@ std::expected<SConfigStateReply, std::st
         if (const auto CFG_ENV = getenv("HYPRLAND_CONFIG"); CFG_ENV)
             return SConfigStateReply{.path = CFG_ENV, .type = CONFIG_TYPE_EXPLICIT};
 
-        const auto LUA_PATHS = Hyprutils::Path::findConfig(ISDEBUG ? "hyprlandd" : "hyprland", "lua");
+        const auto LUA_PATHS = Hyprutils::Path::findConfig("hyprland", "lua");
 
         if (LUA_PATHS.first.has_value())
             return SConfigStateReply{.path = LUA_PATHS.first.value(), .type = CONFIG_TYPE_REGULAR};
         else if (LUA_PATHS.second.has_value()) {
-            auto CONFIGPATH = Hyprutils::Path::fullConfigPath(LUA_PATHS.second.value(), ISDEBUG ? "hyprlandd" : "hyprland", "lua");
+            auto CONFIGPATH = Hyprutils::Path::fullConfigPath(LUA_PATHS.second.value(), "hyprland", "lua");
             return SConfigStateReply{.path = CONFIGPATH, .type = CONFIG_TYPE_REGULAR};
         } else
             return std::unexpected("Neither HOME nor XDG_CONFIG_HOME are set in the environment. Could not find config in XDG_CONFIG_DIRS or /etc/xdg.");
Index: anland-quilt4/src/debug/log/Logger.cpp
===================================================================
--- anland-quilt4.orig/src/debug/log/Logger.cpp
+++ anland-quilt4/src/debug/log/Logger.cpp
@@ -26,7 +26,7 @@ void CLogger::log(Hyprutils::CLI::eLogLe
 
 void CLogger::initIS(const std::string_view& IS) {
     // NOLINTNEXTLINE
-    m_logger.setOutputFile(std::string{IS} + (ISDEBUG ? "/hyprlandd.log" : "/hyprland.log"));
+    m_logger.setOutputFile(std::string{IS} + "/hyprland.log");
     m_logger.setEnableRolling(true);
     m_logger.setEnableColor(false);
     m_logger.setEnableStdout(true);
