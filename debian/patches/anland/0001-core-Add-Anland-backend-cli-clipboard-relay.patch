+        // Consumer -> producer: IME text input from Android soft keyboard.
+        // Two-path strategy:
+        //   Path 1: text-input protocol (zwp_text_input_v3/v1) — best for clients
+        //           that bind the protocol (GTK, Qt, Firefox, foot, etc.)
+        //   Path 2: XKB keysym → keyboard event injection — universal fallback
+        //           that works with any client, including XWayland and simple apps.
+        anland->onTextFromConsumer = [](const char* text, size_t len, void* /*userdata*/) {
+            if (len == 0)
+                return;
+            std::string str(text, len);
+            fprintf(stderr, "anland: consumer text (%zu chars): '%s'\n", len, str.c_str());
+            Log::logger->log(Log::INFO, std::format("anland: consumer text ({} chars): '{}'", len, str));
+            if (!g_pInputManager) {
+                Log::logger->log(Log::ERR, "anland: no InputManager, dropping text");
+                return;
+            }
+            // ── Path 1 (PRIMARY): text-input protocol ─────────────────────
+            // Android supplies committed UTF-8, not an XKB key sequence.  Send it
+            // to a focused text-input client first: this preserves non-ASCII text
+            // (notably Chinese) and lets the client own its IME commit semantics.
+            // The XKB route below can only represent the explicit ASCII map.
+            CTextInput* ti = g_pInputManager->m_relay.getFocusedTextInput();
+            if (ti && ti->isEnabled()) {
+                Log::logger->log(Log::INFO, "anland: using Path 1 (text-input protocol)");
+                ti->commitStringFromConsumer(str);
+                return;
+            }
+            if (ti)
+                Log::logger->log(Log::INFO, "anland: Path 1 skipped (text-input found but not enabled)");
+            else
+                Log::logger->log(Log::INFO, "anland: Path 1 skipped (no focused text-input)");
+
+            // ── Path 2 (FALLBACK): XKB keyboard event injection ────────────
+            // This keeps ASCII input working for clients that do not implement
+            // text-input (including simple/XWayland clients), but cannot encode
+            // Chinese or other characters absent from its explicit key map.
+            Log::logger->log(Log::INFO, std::format("anland: Path 2 — keyboard count={}", g_pInputManager->m_keyboards.size()));
+            SP<::IKeyboard> kb;
+            for (auto const& k : g_pInputManager->m_keyboards) {
+                if (k && k->m_xkbKeymap && k->m_xkbState) {
+                    kb = k;
+                    Log::logger->log(Log::INFO, "anland: Path 2 — found valid XKB keyboard");
