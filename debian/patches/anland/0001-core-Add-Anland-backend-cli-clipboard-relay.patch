+/* Anland clipboard relay: producer -> consumer.
+ * Fires on every Wayland selection change. Reads the payload (plain text,
+ * UTF-8 preferred) synchronously via a pipe and forwards it to the Android
+ * consumer. Loop guards mirroring KWin/mutter:
+ *   - our own CAnlandClipboardSource (set from the consumer) is skipped;
+   *   - identical text is skipped (cache);
+   *   - fallback (consumer disconnected) is skipped. */
+void CCompositor::onAnlandSelectionChanged() {
+    if (!m_pAnlandBackend || m_pAnlandBackend->inFallback())
+        return;
+
+    auto source = g_pSeatManager->m_selection.currentSelection.lock();
+    if (!source) {
+        if (!m_anlandClipboardText.empty()) {
+            m_anlandClipboardText.clear();
+            m_pAnlandBackend->sendClipboardToConsumer("");
+        }
+        return;
+    }
+
+    /* Loop guard: pointer comparison (KWin style: source == m_clipboardSource). */
+    if (dynamic_cast<CAnlandClipboardSource*>(source.get()))
+        return;
+
+    std::string mime;
+    for (const auto& m : source->mimes()) {
+        if (m == "text/plain;charset=utf-8") {
+            mime = m;
+            break;
+        }
+        if (m == "text/plain" && mime.empty())
+            mime = m;
+    }
+    if (mime.empty())
+        return;
+
+    /* KWin-style synchronous read: pipe + send + flush + poll/read loop.
+     * The owning client is a separate process — it receives the wl_data_source.send
+     * request after flush(), writes to the pipe, and closes the write end.  We poll
+     * with a 1s timeout per chunk; 0 on read means EOF (client finished). */
+    int p[2];
+    if (pipe2(p, O_CLOEXEC) != 0)
+        return;
+
+    source->send(mime, Hyprutils::OS::CFileDescriptor{p[1]});
+    wl_display_flush_clients(g_pCompositor->m_wlDisplay);
+
+    std::string text;
+    char        buf[4096];
+    struct pollfd pfd = {.fd = p[0], .events = POLLIN};
+    while (true) {
+        int pr = poll(&pfd, 1, 1000);
+        if (pr <= 0)
+            break;
+        ssize_t n = read(p[0], buf, sizeof(buf));
+        if (n <= 0)
+            break;
+        text.append(buf, n);
+    }
+    close(p[0]);
+
+    if (text.empty() || text == m_anlandClipboardText)
+        return;
+
+    m_anlandClipboardText = text;
+    Log::logger->log(Log::DEBUG, std::format("anland: forwarding clipboard ({} bytes)", text.size()));
+    m_pAnlandBackend->sendClipboardToConsumer(text);
+}
