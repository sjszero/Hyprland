+                    {'U', 22, true}, {'V', 47, true}, {'W', 17, true}, {'X', 45, true},
+                    {'Y', 21, true}, {'Z', 44, true},
+                    {'!', 2, true},  {'@', 3, true},  {'#', 4, true},  {'$', 5, true},
+                    {'%', 6, true},  {'^', 7, true},  {'&', 8, true},  {'*', 9, true},
+                    {'(', 10, true}, {')', 11, true},
+                    {'_', 12, true}, {'+', 13, true},
+                    {'{', 26, true}, {'}', 27, true},
+                    {':', 39, true}, {'"', 40, true},
+                    {'<', 51, true}, {'>', 52, true}, {'?', 53, true},
+                    {'|', 43, true}, {'~', 41, true},
+                };
+                constexpr uint32_t SHIFT_EVDEV = 42; // KEY_LEFTSHIFT
+                struct timespec now;
+                clock_gettime(CLOCK_MONOTONIC, &now);
+                uint32_t timeMs = (uint32_t)(now.tv_sec * 1000 + now.tv_nsec / 1000000);
+                const char* p   = str.data();
+                const char* end = p + str.size();
+                int injected     = 0;
+                while (p < end) {
+                    uint32_t      codepoint = 0;
+                    int           consumed  = 0;
+                    unsigned char c         = (unsigned char)*p;
+                    if ((c & 0x80) == 0) {
+                        codepoint = c;
+                        consumed  = 1;
+                    } else if ((c & 0xE0) == 0xC0 && p + 1 < end) {
+                        codepoint = ((c & 0x1F) << 6) | ((unsigned char)p[1] & 0x3F);
+                        consumed  = 2;
+                    } else if ((c & 0xF0) == 0xE0 && p + 2 < end) {
+                        codepoint = ((c & 0x0F) << 12) | (((unsigned char)p[1] & 0x3F) << 6) | ((unsigned char)p[2] & 0x3F);
+                        consumed  = 3;
+                    } else if ((c & 0xF8) == 0xF0 && p + 3 < end) {
+                        codepoint = ((c & 0x07) << 18) | (((unsigned char)p[1] & 0x3F) << 12) | (((unsigned char)p[2] & 0x3F) << 6) | ((unsigned char)p[3] & 0x3F);
+                        consumed  = 4;
+                    } else {
+                        p++;
+                        continue;
+                    }
+                    p += consumed;
+                    // Look up in our evdev table
+                    const CharMapping* m = nullptr;
+                    for (auto& cm : charMap) {
+                        if (cm.cp == codepoint) { m = &cm; break; }
