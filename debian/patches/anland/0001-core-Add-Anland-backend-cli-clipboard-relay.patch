+                    // Press Shift if needed
+                    if (m->shift) {
+                        // Update XKB state so the compositor knows Shift is active
+                        kb->updateXkbStateWithKey(SHIFT_EVDEV + 8, true);
+                        kb->updateModifiersState();
+                        ::IKeyboard::SKeyEvent shiftPress{timeMs, SHIFT_EVDEV, true, WL_KEYBOARD_KEY_STATE_PRESSED};
+                        g_pInputManager->onKeyboardKey(shiftPress, kb);
+                    }
+                    // Press + release the key
+                    ::IKeyboard::SKeyEvent pressEvent{timeMs, m->evdev, true, WL_KEYBOARD_KEY_STATE_PRESSED};
+                    g_pInputManager->onKeyboardKey(pressEvent, kb);
+                    ::IKeyboard::SKeyEvent releaseEvent{timeMs, m->evdev, false, WL_KEYBOARD_KEY_STATE_RELEASED};
+                    g_pInputManager->onKeyboardKey(releaseEvent, kb);
+                    // Release Shift
+                    if (m->shift) {
+                        ::IKeyboard::SKeyEvent shiftRelease{timeMs, SHIFT_EVDEV, false, WL_KEYBOARD_KEY_STATE_RELEASED};
