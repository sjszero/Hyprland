+        // Consumer -> producer: clipboard text arrived from Android.
+        anland->onClipboardFromConsumer = [](const char* text, size_t len, void* /*userdata*/) {
+            if (len == 0) {
+                Log::logger->log(Log::DEBUG, "anland: consumer cleared clipboard");
+                /* Android clipboard cleared: mirror it locally (KWin parity).
+                 * Loop-guarded downstream: our own CAnlandClipboardSource is
+                 * skipped by dynamic_cast, and the empty text cache stops the
+                 * echo from re-sending an empty clipboard back. */
+                if (g_pSeatManager)
+                    g_pSeatManager->setCurrentSelection(nullptr);
+                return;
