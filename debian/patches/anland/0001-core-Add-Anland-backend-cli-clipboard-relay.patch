+            std::string str(text, len);
+            Log::logger->log(Log::DEBUG, std::format("anland: consumer clipboard ({} bytes)", len));
+            if (g_pSeatManager) {
+                auto source = Hyprutils::Memory::makeShared<CAnlandClipboardSource>(str);
+                g_pSeatManager->setCurrentSelection(source);
