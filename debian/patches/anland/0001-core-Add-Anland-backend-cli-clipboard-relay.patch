+#include <thread>
+#include <poll.h>
+class CAnlandClipboardSource : public IDataSource {
+  public:
+    explicit CAnlandClipboardSource(const std::string& text) : m_text(text) {
+        m_mimeTypes = {
+            "text/plain;charset=utf-8",
+            "text/plain",
+            "UTF8_STRING",
+            "TEXT",
+            "STRING"
+        };
+    }
+    virtual std::vector<std::string> mimes() override { return m_mimeTypes; }
+    virtual void send(const std::string& mime, Hyprutils::OS::CFileDescriptor fd) override {
+        const std::string& data = m_text;
+        int fdCopy = fd.take();
+        std::string dataCopy = data;
+        std::thread([fdCopy, dataCopy]() {
+            size_t n = 0;
+            while (n < dataCopy.size()) {
+                ssize_t w = ::write(fdCopy, dataCopy.data() + n, dataCopy.size() - n);
+                if (w > 0) {
+                    n += w;
+                    continue;
+                }
+                if (w < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+                    /* Non-blocking pipe: wait for the reader instead of giving up.
+                     * Breaking here would close the fd with 0 bytes written and
+                     * the paste would come out empty. */
+                    struct pollfd pfd = {.fd = fdCopy, .events = POLLOUT};
+                    ::poll(&pfd, 1, 2000);
+                    continue;
+                }
+                break; /* EOF or fatal error */
+            }
+            ::close(fdCopy);
+        }).detach();
+    }
+    virtual void accepted(const std::string&) override {}
+    virtual void cancelled() override {}
+    virtual bool hasDnd() override { return false; }
+    virtual bool dndDone() override { return false; }
+    virtual void sendDndFinished() override {}
+    virtual bool used() override { return false; }
+    virtual void markUsed() override {}
+    virtual void error(uint32_t, const std::string&) override {}
+    virtual eDataSourceType type() override { return DATA_SOURCE_TYPE_WAYLAND; }
+    virtual uint32_t actions() override { return 0; }
+    virtual void sendDndDropPerformed() override {}
+    virtual void sendDndAction(wl_data_device_manager_dnd_action) override {}
+  private:
+    std::string m_text;
+    std::vector<std::string> m_mimeTypes;
+};
+
