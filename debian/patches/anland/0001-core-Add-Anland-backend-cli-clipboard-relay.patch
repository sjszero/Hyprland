+                    {'\\', 43, false}, {'`', 41, false},
+                    {' ', 57, false}, {'\t', 15, false}, {'\n', 28, false},
+                    // ── level 1 (shift) ──
+                    {'A', 30, true}, {'B', 48, true}, {'C', 46, true}, {'D', 32, true},
+                    {'E', 18, true}, {'F', 33, true}, {'G', 34, true}, {'H', 35, true},
