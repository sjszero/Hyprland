 }
+
+void CTextInput::commitStringFromConsumer(const std::string& text) {
+    if (text.empty())
+        return;
+    fprintf(stderr, "anland: commitStringFromConsumer isV3=%d text='%s'\n", (int)isV3(), text.c_str());
+    if (isV3()) {
+        const auto V3 = m_v3Input.lock();
+        if (V3) {
+            fprintf(stderr, "anland: commitStringFromConsumer V3 commitString\n");
+            V3->commitString(text);
+        } else
+            fprintf(stderr, "anland: commitStringFromConsumer V3 lock FAILED\n");
+    } else {
+        const auto V1 = m_v1Input.lock();
+        if (V1 && V1->m_active) {
+            fprintf(stderr, "anland: commitStringFromConsumer V1 commitString serial=%u\n", V1->m_serial);
+            V1->commitString(V1->m_serial, text.c_str());
+        } else
+            fprintf(stderr, "anland: commitStringFromConsumer V1 lock=%d active=%d\n", (bool)V1, V1 ? (int)V1->m_active : -1);
+    }
+}
