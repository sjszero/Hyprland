#!/bin/sh
# Anland session launcher for the Debian-patched Hyprland build.
# It deliberately owns neither PipeWire nor WirePlumber: an existing user
# session is reused.  Processes started here are stopped when Hyprland exits.

set -eu

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$runtime"
mkdir -p "$XDG_RUNTIME_DIR"

children=""
cleanup() {
    for pid in $children; do
        kill "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT HUP INT TERM

start_if_missing() {
    socket="$1"
    shift
    if [ -S "$socket" ]; then
        return 0
    fi
    "$@" >/dev/null 2>&1 &
    children="$children $!"
}

# PipeWire is required by Aquamarine's Anland audio bridge.  Do not create a
# second graph when a normal desktop session already provides one.
start_if_missing "$XDG_RUNTIME_DIR/pipewire-0" pipewire

for _ in $(seq 1 20); do
    [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] && break
    sleep 0.05
done

if ! pgrep -u "$(id -u)" -x wireplumber >/dev/null 2>&1; then
    wireplumber >/dev/null 2>&1 &
    children="$children $!"
fi

# Pulse compatibility is optional; avoid duplicating a daemon supplied by the
# host session.
if command -v pipewire-pulse >/dev/null 2>&1 && [ ! -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
    pipewire-pulse >/dev/null 2>&1 &
    children="$children $!"
fi

# DMS is supplied by the official AvengeMedia package.  Start it after
# Hyprland has created its Wayland and IPC sockets; --session preserves the
# official package's session semantics.
start_dms() {
    if pgrep -u "$(id -u)" -x dms >/dev/null 2>&1; then
        return 0
    fi
    i=0
    while [ "$i" -lt 100 ]; do
        for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
            [ -S "$socket" ] || continue
            WAYLAND_DISPLAY="${socket##*/}" QT_QPA_PLATFORM=wayland exec dms run --session
            return 0
        done
        i=$((i + 1))
        sleep 0.05
    done
    echo "start-hyprland-anland: DMS was not started because the Wayland socket was not ready" >&2
}

if command -v dms >/dev/null 2>&1; then
    start_dms &
    children="$children $!"
else
    echo "start-hyprland-anland: official dms package is unavailable; starting compositor only" >&2
fi

/usr/bin/start-hyprland --anland "$@" &
hyprland_pid=$!
wait "$hyprland_pid"
exit $?